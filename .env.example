# Copy to client/.env.local
# The AI provider, model and API key are not set here: an admin saves them on /admin.

# Supabase (leave both empty to run without login or persistence; the chats need it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Lets the chats read the AI provider, model and key saved on /admin
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. A random string; Vercel Cron sends it to run the daily CBMSC site check
CRON_SECRET=
# Server-only. The PDF microservice in services/pdf; without the URL only the .docx is generated.
# Locally, after `docker compose up -d pdf`: http://localhost:3001, local, local-only
PDF_SERVICE_URL=
PDF_SERVICE_USER=
PDF_SERVICE_PASSWORD=
# Google OAuth web client ID (the same one set in Supabase → Providers → Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-only. Secret of that same Google client; trades the login popup's code for an ID token
GOOGLE_CLIENT_SECRET=
# Optional: only accept Google accounts from this domain (e.g. mourasengenharia.com).
# A domain saved on /admin takes precedence.
ALLOWED_EMAIL_DOMAIN=
