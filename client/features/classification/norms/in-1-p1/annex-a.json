  "quadro_3_risco_iii_criterio": [
    {
      "group": "F",
      "division": "TODAS",
      "criterion": "AQUELES NÃO ENQUADRADOS NO RISCO II MAS QUE AINDA POSSUAM POPULAÇÃO ≤ 200 PESSOAS (EM CADA ÁREA DE REUNIÃO DE PÚBLICO) E",
      "page": 44
