  "notes": [
    {
      "number": 1,
      "text": "Exige-se brigadistas orgânicos de acordo com a população fixa. Para F-6, além de brigadista orgânico, exige-se brigadista particular (ver IN 28)."
    },
    {
      "number": 2,
      "text": "Exigido para F-5, F-6 e F-10 independente de altura e F-8 com altura superior a 12 m. Pode ser substituído por detecção automática e chuveiros automáticos."
    },
    {
      "number": 3,
      "text": "Pode ser substituída por controle de fumaça e chuveiros automáticos, exceto para compartimentação de fachada, shafts e dutos."
    },
    {
      "number": 4,
      "text": "Exigido para F-5, F-6 e F-10 com lotação igual ou superior a 2.000 pessoas. Para F-8 é exigido em imóveis que possuam altura igual ou superior a 60 m."
    },
    {
      "number": 5,
      "text": "Exigido para imóveis com lotação igual ou superior a 100 pessoas."
    },
    {
      "number": 6,
      "text": "Exigido em todos os locais com carga de incêndio superior a 300 MJ/m²; locais onde exista forro falso com revestimento combustível; depósitos, escritórios, cozinhas, pisos técnicos, casa de máquinas; ambientes com equipamentos elétricos para sonorização e iluminação."
    },
    {
      "number": 7,
      "text": "Exigido para imóveis que possuam altura igual ou superior a 40 m."
    },
    {
      "number": 8,
      "text": "Dispensado para imóveis com lotação inferior a 200 pessoas e com funcionamento até as 18:00h."
    },
    {
      "number": 9,
      "text": "Vital apenas para F-5, F-6 e F-8."
    },
    {
      "number": 10,
      "text": "Somente para locais com público igual ou superior a 1.000 pessoas."
    },
    {
      "number": 11,
      "text": "Dispensado para salões de festas, subsidiários a ocupação A-2, se para a edificação não for exigido sistema de chuveiros automáticos."
    },
    {
      "number": 12,
      "text": "Dispensado para salões de festas subsidiários a qualquer ocupação desde que possua lotação máxima de até 100 pessoas."
    }
  ],
