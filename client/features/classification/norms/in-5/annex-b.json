    "IEBT": "Instalação elétrica de baixa tensão",
    "Comp": "Compartimentação",
    "CMAR": "Materiais de revestimento e acabamento",
    "SPK": "Chuveiros automáticos",
    "RES": "Resfriamento ou espuma",
    "SHP": "Sistema hidráulico preventivo",
    "TODOS": "Todos os sistemas e medidas de segurança previstos nas NSCI são considerados vitais",
